(version 1)
(allow default)
(deny user-preference-read)
(deny user-preference-write)
(deny mach-lookup (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent"))
(deny file-read* (subpath (param "PREFS")) (subpath (param "GROUP")) (subpath (param "CONTAINER")))
(deny file-write* (subpath (param "PREFS")) (subpath (param "GROUP")) (subpath (param "CONTAINER")))
(deny network-outbound (remote ip "*:*"))
(deny file-write* (require-not (require-any (subpath (param "BENCH")) (subpath (param "TEMP")) (literal "/dev/null"))))
